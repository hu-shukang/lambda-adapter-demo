  "sideEffects": false,
  "type": "module",
  "scripts": {
    "prisma:studio": "npx prisma studio",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:init": "npx prisma migrate dev --name init",
    "prisma:migrate": "npx prisma migrate dev",
    "build": "remix vite:build",
    "build:lambda": "tsc --project lambda/tsconfig.json",
    "dev": "remix vite:dev",
    "dev:host": "remix vite:dev --host 0.0.0.0",
    "format": "prettier --ignore-path .gitignore --ignore-unknown --cache --cache-location node_modules/.cache/prettiercache --write .",

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "preserveConstEnums": true,
    "noEmit": false,
    "sourceMap": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "/opt/nodejs/dist/*": ["common-layer/nodejs/*"]
    }
  },
  "exclude": ["node_modules", "**/*.test.ts"],
  "include": ["./**/*.ts"]
}

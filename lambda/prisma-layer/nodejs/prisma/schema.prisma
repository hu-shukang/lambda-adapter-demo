generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String             @id
  name               String
  description        String
  updateTime         DateTime
  updateUser         String
  parentId           String?
  Organization       Organization?      @relation("OrganizationToOrganization", fields: [parentId], references: [id])
  other_Organization Organization[]     @relation("OrganizationToOrganization")
  UserOrganization   UserOrganization[]
}

model User {
  id                String             @id
  email             String             @unique
  name              String
  status            String
  enterDay          DateTime
  cognitoUserStatus String
  updateTime        DateTime
  updateUser        String
  UserOrganization  UserOrganization[]
}

model UserOrganization {
  userId         String
  organizationId String
  role           String
  updateTime     DateTime
  updateUser     String
  Organization   Organization @relation(fields: [organizationId], references: [id])
  User           User         @relation(fields: [userId], references: [id])

  @@id([userId, organizationId])
}
